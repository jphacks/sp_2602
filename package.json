{
  "name": "hackathon-kit",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "lint": "biome ci . && node scripts/check-style.mjs && node scripts/gen-codeowners.mjs --check",
    "fix": "biome check --write .",
    "check": "npm run lint && npm run typecheck && npm run test && npm run scope",
    "now": "node scripts/now.mjs",
    "doctor": "node scripts/doctor.mjs",
    "preflight": "node scripts/preflight.mjs",
    "scope": "node scripts/check-scope.mjs",
    "kit:setup": "node scripts/setup.mjs",
    "kit:whoami": "node scripts/whoami.mjs",
    "kit:owners": "node scripts/gen-codeowners.mjs",
    "step": "node scripts/step.mjs",
    "declare": "node scripts/declare.mjs",
    "kit:stub": "node scripts/stub.mjs",
    "issue": "node scripts/issue.mjs",
    "log": "node scripts/log.mjs",
    "merge": "node scripts/merge.mjs",
    "kit:reset": "node scripts/kit-reset.mjs",
    "kit:schedule": "node scripts/schedule.mjs",
    "kit:deadlines": "node scripts/deadlines.mjs",
    "kit:alarm": "node scripts/alarm.mjs",
    "status": "node scripts/status.mjs",
    "handoff": "node scripts/handoff.mjs",
    "shot": "node scripts/shot.mjs",
    "api": "node scripts/api.mjs",
    "db:push": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/db-push.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "@neondatabase/serverless": "^1.2.0",
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
