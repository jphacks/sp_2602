{
  "name": "hackathon-kit",
  "private": true,
  "type": "module",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start --dev-client",
    "dev:server": "tsx watch --env-file-if-exists=.env --env-file-if-exists=.env.local src/server/dev.ts",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome ci . && node scripts/check-style.mjs",
    "fix": "biome check --write .",
    "check": "npm run lint && npm run typecheck && npm run test && npm run changelog",
    "now": "node scripts/now.mjs",
    "doctor": "node scripts/doctor.mjs",
    "preflight": "node scripts/preflight.mjs",
    "changelog": "node scripts/check-changelog.mjs",
    "kit:setup": "node scripts/setup.mjs",
    "kit:whoami": "node scripts/whoami.mjs",
    "step": "node scripts/step.mjs",
    "declare": "node scripts/declare.mjs",
    "kit:stub": "node scripts/stub.mjs",
    "issue": "node scripts/issue.mjs",
    "log": "node scripts/log.mjs",
    "merge": "node scripts/merge.mjs",
    "kit:reset": "node scripts/kit-reset.mjs",
    "kit:schedule": "node scripts/schedule.mjs",
    "kit:deadlines": "node scripts/deadlines.mjs",
    "kit:alarm": "node scripts/alarm.mjs",
    "status": "node scripts/status.mjs",
    "shot": "node scripts/shot.mjs",
    "api": "node scripts/api.mjs",
    "db:push": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/db-push.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "@hono/node-server": "^2.1.5",
    "@neondatabase/serverless": "^1.2.0",
    "drizzle-orm": "^0.45.4",
    "expo": "~58.0.12",
    "expo-constants": "~58.0.12",
    "expo-dev-client": "~58.0.13",
    "expo-linking": "~58.0.13",
    "expo-router": "~58.0.21",
    "expo-status-bar": "~58.0.3",
    "hono": "^4.13.13",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.4",
    "@types/react": "~19.3.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
