{
  "name": "slope",
  "private": true,
  "type": "module",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start --dev-client",
    "dev:server": "tsx watch --env-file-if-exists=.env --env-file-if-exists=.env.local src/server/dev.ts",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome ci .",
    "fix": "biome check --write .",
    "check": "npm run lint && npm run typecheck && npm run test",
    "db:generate": "node --env-file-if-exists=.env --env-file-if-exists=.env.local node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file-if-exists=.env --env-file-if-exists=.env.local node_modules/drizzle-kit/bin.cjs migrate --config=drizzle.config.ts",
    "db:push": "npm run db:generate && npm run db:migrate",
    "db:seed-demo": "tsx scripts/seed-demo.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "@hono/node-server": "^2.1.5",
    "@neondatabase/serverless": "^1.2.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "drizzle-orm": "^0.45.4",
    "expo": "~58.0.12",
    "expo-camera": "~58.0.10",
    "expo-constants": "~58.0.12",
    "expo-dev-client": "~58.0.13",
    "expo-font": "~58.0.8",
    "expo-linking": "~58.0.13",
    "expo-router": "~58.0.21",
    "expo-status-bar": "~58.0.3",
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-qrcode-svg": "^6.3.26",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.4",
    "@types/react": "~19.3.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "xcode": {
      "uuid": "^11.1.1"
    },
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.0"
    }
  }
}
