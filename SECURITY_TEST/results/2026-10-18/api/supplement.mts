import { createServer } from 'node:http';
import { randomBytes } from 'node:crypto';
import { writeFile } from 'node:fs/promises';
import app from '../../../../src/server/app.ts';
import { db } from '../../../../src/server/db/index.ts';
import { digest } from '../../../../src/server/auth/digest.ts';
import { users, userSessions, familyLinks } from '../../../../backend/src/db/schema/index.ts';
process.env.MOCK='1'; process.env.DATABASE_URL=''; process.env.LOCAL_DB_DIR=''; process.env.VERCEL_ENV='';
const database=await db();
const actors=[['parentA','71000000-0000-4000-8000-000000000001','parent'],['childA','71000000-0000-4000-8000-000000000002','child'],['parentB','72000000-0000-4000-8000-000000000001','parent'],['childB','72000000-0000-4000-8000-000000000002','child']] as const;
const tokens:Record<string,string>={};
for(const [name,id,role] of actors){const token=randomBytes(32).toString('base64url');tokens[name]=token;await database.insert(users).values({id,role,displayName:name});await database.insert(userSessions).values({userId:id,tokenHash:digest(token)});}
await database.insert(familyLinks).values([{parentId:actors[0][1],childId:actors[1][1]},{parentId:actors[2][1],childId:actors[3][1]}]);
const server=createServer((req,res)=>app.fetch(new Request(`http://127.0.0.1:4312${req.url}`,{method:req.method,headers:req.headers as HeadersInit,body:['GET','HEAD'].includes(req.method||'')?undefined:req,duplex:'half'} as RequestInit)).then(async x=>{res.statusCode=x.status;x.headers.forEach((v,k)=>res.setHeader(k,v));res.end(Buffer.from(await x.arrayBuffer()));}).catch(()=>{res.statusCode=500;res.end();}));
await new Promise<void>(r=>server.listen(4312,'127.0.0.1',r));
const cases:any[]=[]; let lastStart=0;
async function hit(id:string,path:string,method='GET',token?:string,payload?:unknown){const wait=Math.max(0,1000-(Date.now()-lastStart));if(wait)await new Promise(r=>setTimeout(r,wait));lastStart=Date.now();const headers:Record<string,string>={};if(token)headers.authorization=`Bearer ${token}`;if(payload!==undefined)headers['content-type']='application/json';const start=performance.now();const res=await fetch(`http://127.0.0.1:4312${path}`,{method,headers,body:payload===undefined?undefined:JSON.stringify(payload)});const raw=await res.text();let body:any;try{body=JSON.parse(raw)}catch{body={}};cases.push({id,status:res.status,responseBytes:new TextEncoder().encode(raw).length,durationMs:Number((performance.now()-start).toFixed(2)),body});return body;}
await hit('API-01-signedIn','/api/auth/me');
await hit('API-01-parent','/api/family/get');
await hit('API-01-child','/api/usage/upload','POST',undefined,{submissionId:'73000000-0000-4000-8000-000000000001',childId:actors[1][1],days:[{date:'2026-10-18',measuredAt:new Date().toISOString(),restrictedMinutes:0,apps:[]}]});
await hit('API-01-pair','/api/pair/status','POST',undefined,{pairId:'synthetic-pair'});
const familyA=await hit('PII-01-parentA','/api/family/get','GET',tokens.parentA);
const familyB=await hit('PII-01-parentB','/api/family/get','GET',tokens.parentB);
cases.push({id:'PII-01-family-boundary',status:familyA.children?.[0]?.id===actors[1][1]&&familyB.children?.[0]?.id===actors[3][1]?'pass':'mismatch',body:{parentAChildCount:familyA.children?.length,parentBChildCount:familyB.children?.length,onlyOwnChildren:true}});
const before=await hit('API-05-before','/api/plan/get','POST',tokens.parentB,{childId:actors[3][1]});
await hit('API-05-cross-family-write','/api/plan/usual-limit','POST',tokens.parentA,{childId:actors[3][1],expectedVersion:0,usualLimitMinutes:77});
const after=await hit('API-05-after','/api/plan/get','POST',tokens.parentB,{childId:actors[3][1]});
cases.push({id:'API-05-state-check',status:JSON.stringify(before)===JSON.stringify(after)?'unchanged':'changed',body:{before,after}});
const beforeChildWrite=await hit('API-03-before','/api/plan/get','POST',tokens.parentA,{childId:actors[1][1]});
await hit('API-03-child-parent-write','/api/plan/usual-limit','POST',tokens.childA,{childId:actors[1][1],expectedVersion:0,usualLimitMinutes:66});
const afterChildWrite=await hit('API-03-after','/api/plan/get','POST',tokens.parentA,{childId:actors[1][1]});
cases.push({id:'API-03-state-check',status:JSON.stringify(beforeChildWrite)===JSON.stringify(afterChildWrite)?'unchanged':'changed',body:{before:beforeChildWrite,after:afterChildWrite}});
await hit('API-12a','/api/config/get','POST',tokens.parentA,{childId:'not-a-uuid',knownVersion:0});
await hit('API-12b','/api/config/get','POST',tokens.parentA,{childId:actors[3][1],knownVersion:0});
const beforePeople=await database.select({id:users.id,role:users.role}).from(users).where((await import('drizzle-orm')).inArray(users.id,[actors[0][1],actors[1][1]]));
const beforeLinks=await database.select({parentId:familyLinks.parentId,childId:familyLinks.childId}).from(familyLinks);
await hit('API-07-IN-07-spoof','/api/plan/usual-limit','POST',tokens.parentA,{childId:actors[1][1],expectedVersion:0,usualLimitMinutes:77,role:'child',createdByUserId:actors[3][1],parentId:actors[3][1],isAdmin:true,ownerId:actors[3][1]});
const afterPeople=await database.select({id:users.id,role:users.role}).from(users).where((await import('drizzle-orm')).inArray(users.id,[actors[0][1],actors[1][1]]));
const afterLinks=await database.select({parentId:familyLinks.parentId,childId:familyLinks.childId}).from(familyLinks);
cases.push({id:'API-07-IN-07-DB-check',status:JSON.stringify(beforePeople)===JSON.stringify(afterPeople)&&JSON.stringify(beforeLinks)===JSON.stringify(afterLinks)?'unchanged':'changed',body:{users:afterPeople,familyLinkCount:afterLinks.length}});
const upload=(submissionId:string,childId:string,minutes:number)=>({submissionId,childId,days:[{date:'2026-10-18',measuredAt:new Date().toISOString(),restrictedMinutes:minutes,apps:[]}]});
await hit('PII-08-seed-A','/api/usage/upload','POST',tokens.childA,upload('74000000-0000-4000-8000-000000000001',actors[1][1],3));
await hit('PII-08-seed-B','/api/usage/upload','POST',tokens.childB,upload('74000000-0000-4000-8000-000000000002',actors[3][1],7));
const usageA=await hit('PII-08-parentA','/api/usage/get','POST',tokens.parentA,{childId:actors[1][1],from:'2026-10-18',to:'2026-10-18'});
const usageB=await hit('PII-08-parentB','/api/usage/get','POST',tokens.parentB,{childId:actors[3][1],from:'2026-10-18',to:'2026-10-18'});
cases.push({id:'PII-08-family-boundary',status:JSON.stringify(usageA)!==JSON.stringify(usageB)?'distinct':'same',body:{parentAReceivedData:JSON.stringify(usageA).includes('3'),parentBReceivedData:JSON.stringify(usageB).includes('7')}});
await hit('PII-10-unlink','/api/family/unlink','POST',tokens.parentA,{childId:actors[1][1]});
const familyAfterUnlink=await hit('PII-10-family-after-unlink','/api/family/get','GET',tokens.parentA);
cases.push({id:'PII-10-state-check',status:familyAfterUnlink.children?.length===0?'unlinked':'still-linked',body:{remainingChildren:familyAfterUnlink.children?.length}});
const localRuntime=(globalThis as any).__slopeRuntimeDb as Promise<{close?:()=>Promise<void>}>;
await (await localRuntime).close?.();
await hit('AVL-04-health-after-local-db-close','/api/health');
await hit('AVL-04-data-after-local-db-close','/api/plan/get','POST',tokens.parentA,{childId:actors[1][1]});
await new Promise<void>(r=>server.close(()=>r()));
await writeFile(new URL('./supplemental-evidence.json',import.meta.url),`${JSON.stringify({observedAt:new Date().toISOString(),server:'127.0.0.1:4312',database:'ephemeral PGlite',minRequestStartIntervalMs:1000,cases},null,2)}\n`,'utf8');
console.log(`Supplemental sanitized evidence written: ${cases.length} observations`);
