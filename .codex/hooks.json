{
  "description": "hackathon-kit の守り（.claude/settings.json の Codex 版）。型が通らないまま終わらせない。説明は docs/kit/codex.md",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .codex/hooks/stop-check.mjs",
            "timeout": 300,
            "statusMessage": "型チェックをしています"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .codex/hooks/guard-bash.mjs",
            "timeout": 30,
            "statusMessage": "コマンドを確かめています"
          }
        ]
      }
    ]
  }
}
