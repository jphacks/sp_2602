{
  "expo": {
    "name": "hackathon-kit",
    "slug": "hackathon-kit",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "hackathonkit",
    "platforms": ["android"],
    "android": {
      "package": "dev.hackathon.kit",
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-camera",
        {
          "cameraPermission": "子どもの端末の QR コードを読むためにカメラを使います",
          "recordAudioAndroid": false
        }
      ]
    ]
  }
}
