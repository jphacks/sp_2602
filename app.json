{
  "expo": {
    "name": "Slope",
    "slug": "slope",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "slope",
    "platforms": ["android"],
    "icon": "./assets/icon.png",
    "android": {
      "package": "com.quedotcom.androidslope",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F9828A"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-camera",
        {
          "cameraPermission": "子どものスマホに出ている QR コードを読み取るためにカメラを使います",
          "recordAudioAndroid": false
        }
      ],
      "@react-native-community/datetimepicker",
      ["@react-native-google-signin/google-signin", { "iosUrlScheme": "com.googleusercontent.apps.ios-not-used-yet" }]
    ]
  }
}
